# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
# Domaine public (QR = https://{PUBLIC_DOMAIN}/s/{slug}) — À CONFIRMER
PUBLIC_DOMAIN=localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# mock | live
WALLET_MODE=mock

# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nejmti:nejmti@localhost:5432/nejmti?schema=public

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth JWT ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Stockage S3-compatible ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nejmti
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# ─── Email SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nejmti <noreply@nejmti.local>"

# ─── Facturation (valeurs par défaut proposées — À CONFIRMER) ────────────────
DEFAULT_CURRENCY=TND
DEFAULT_TRIAL_DAYS=14
DEFAULT_GRACE_DAYS=7
# manual | konnect | paymee | clicToPay
PAYMENT_GATEWAY=manual
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ─── Apple Wallet (Phase 5 — laisser vide en mock) ───────────────────────────
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT_PATH=
APPLE_SIGNER_CERT_PATH=
APPLE_SIGNER_KEY_PATH=
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_APNS_KEY_PATH=
APPLE_APNS_KEY_ID=

# ─── Google Wallet (Phase 5 — laisser vide en mock) ──────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Observabilité ───────────────────────────────────────────────────────────
LOG_LEVEL=info
